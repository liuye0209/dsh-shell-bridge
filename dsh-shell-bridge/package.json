{
  "name": "dsh-shell-bridge",
  "version": "1.2.0",
  "description": "Conservative Bash-to-Windows PowerShell compatibility guard for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "src", "benchmark", "scripts", "cordis.patch.yml", "README.md", "CHANGELOG.md", "test"],
  "engines": {"node": ">=22.19.0"},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5 <0.3.0"
  },
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
  "scripts": {
    "test": "node --test test/index.test.js",
    "benchmark": "node benchmark/runner.mjs",
    "check:dsh": "node scripts/check-dsh.mjs"
  }
}
